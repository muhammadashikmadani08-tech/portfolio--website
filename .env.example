# .env.example — FAKE / EXAMPLE values only. Never put real secrets here.
# This static portfolio needs NO .env file and NO secrets to run.
# This file exists only so you understand the pattern IF you later add
# an optional service. Do NOT commit a real .env file (see .gitignore).

# Optional: Formspree form ID (NOT a secret — it is a public form identifier).
# Get a real one at https://formspree.io — free tier: 50 submissions/month (check current limits).
# If you do not use Formspree, leave this empty and the contact form uses a mailto draft.
FORMSPREE_FORM_ID=example123456

# Optional: public contact email shown on the site (also set it in assets/js/config.js).
CONTACT_EMAIL=you@example.com

# DO NOT add: passwords, private API keys, tokens. This frontend has no backend to keep them safe.
